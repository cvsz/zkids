# Copy to .env for local development and customize safely.
# Never commit real credentials or production secrets.

APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

# When set, API mutation/read surfaces require signed bearer tokens.
ZKIDS_AUTH_SECRET=change-me

DATABASE_URL=postgresql://zkids:zkids@localhost:5432/zkids
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=zkids
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=zkids
AWS_SECRET_ACCESS_KEY=change-me

# Provider endpoints are operator-configured. Secrets are always read from env.
IMAGE_PROVIDER_ENDPOINT=
IMAGE_PROVIDER_MODEL=
IMAGE_PROVIDER_API_KEY=
VOICE_PROVIDER_ENDPOINT=
VOICE_PROVIDER_MODEL=
VOICE_PROVIDER_API_KEY=
MOTION_PROVIDER_ENDPOINT=
MOTION_PROVIDER_MODEL=
MOTION_PROVIDER_API_KEY=
