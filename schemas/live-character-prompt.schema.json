{
  "$defs": {
    "IdentityLock": {
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "enforcement": {
          "default": "hard",
          "enum": [
            "hard",
            "preferred"
          ],
          "title": "Enforcement",
          "type": "string"
        },
        "never_change": {
          "default": true,
          "title": "Never Change",
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "title": "IdentityLock",
      "type": "object"
    },
    "LatencyTargets": {
      "properties": {
        "input_acknowledgement_ms": {
          "default": 250,
          "title": "Input Acknowledgement Ms",
          "type": "integer"
        },
        "first_audio_ms": {
          "default": 800,
          "title": "First Audio Ms",
          "type": "integer"
        },
        "user_interrupt_response_ms": {
          "default": 150,
          "title": "User Interrupt Response Ms",
          "type": "integer"
        }
      },
      "title": "LatencyTargets",
      "type": "object"
    },
    "LiveCharacterIdentityLocks": {
      "properties": {
        "fur_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentityLock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "red_scarf": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentityLock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "LiveCharacterIdentityLocks",
      "type": "object"
    },
    "LiveCharacterLook": {
      "properties": {
        "body": {
          "items": {
            "type": "string"
          },
          "title": "Body",
          "type": "array"
        },
        "face": {
          "items": {
            "type": "string"
          },
          "title": "Face",
          "type": "array"
        },
        "fur": {
          "items": {
            "type": "string"
          },
          "title": "Fur",
          "type": "array"
        },
        "clothing": {
          "items": {
            "type": "string"
          },
          "title": "Clothing",
          "type": "array"
        }
      },
      "title": "LiveCharacterLook",
      "type": "object"
    },
    "LiveCharacterSpec": {
      "properties": {
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "species": {
          "title": "Species",
          "type": "string"
        },
        "role": {
          "default": "family-friendly virtual companion",
          "title": "Role",
          "type": "string"
        },
        "age_appearance": {
          "default": "childlike",
          "title": "Age Appearance",
          "type": "string"
        },
        "presentation": {
          "default": "innocent, playful, warm, never sexualized",
          "title": "Presentation",
          "type": "string"
        },
        "look": {
          "$ref": "#/$defs/LiveCharacterLook"
        },
        "personality": {
          "items": {
            "type": "string"
          },
          "title": "Personality",
          "type": "array"
        },
        "signature_actions": {
          "items": {
            "type": "string"
          },
          "title": "Signature Actions",
          "type": "array"
        },
        "identity_locks": {
          "$ref": "#/$defs/LiveCharacterIdentityLocks"
        }
      },
      "required": [
        "character_id",
        "name",
        "species"
      ],
      "title": "LiveCharacterSpec",
      "type": "object"
    },
    "LiveState": {
      "properties": {
        "emotion": {
          "title": "Emotion",
          "type": "string"
        },
        "animation": {
          "title": "Animation",
          "type": "string"
        }
      },
      "required": [
        "emotion",
        "animation"
      ],
      "title": "LiveState",
      "type": "object"
    },
    "LiveStateMachine": {
      "properties": {
        "initial_state": {
          "default": "idle",
          "title": "Initial State",
          "type": "string"
        },
        "states": {
          "additionalProperties": {
            "$ref": "#/$defs/LiveState"
          },
          "title": "States",
          "type": "object"
        },
        "transition_rules": {
          "items": {
            "$ref": "#/$defs/TransitionRule"
          },
          "title": "Transition Rules",
          "type": "array"
        }
      },
      "title": "LiveStateMachine",
      "type": "object"
    },
    "LiveVoiceConfig": {
      "properties": {
        "language_priority": {
          "items": {
            "type": "string"
          },
          "title": "Language Priority",
          "type": "array"
        },
        "style": {
          "default": "warm, bright, friendly, concise, natural",
          "title": "Style",
          "type": "string"
        },
        "pitch": {
          "default": "light and expressive, never imitate an identifiable person",
          "title": "Pitch",
          "type": "string"
        },
        "speed_wpm": {
          "default": 145,
          "title": "Speed Wpm",
          "type": "integer"
        },
        "prosody": {
          "items": {
            "type": "string"
          },
          "title": "Prosody",
          "type": "array"
        },
        "tts_requirements": {
          "$ref": "#/$defs/TTSRequirements"
        }
      },
      "title": "LiveVoiceConfig",
      "type": "object"
    },
    "MemoryPolicy": {
      "properties": {
        "consent_required": {
          "default": true,
          "title": "Consent Required",
          "type": "boolean"
        },
        "may_remember": {
          "items": {
            "type": "string"
          },
          "title": "May Remember",
          "type": "array"
        },
        "never_remember": {
          "items": {
            "type": "string"
          },
          "title": "Never Remember",
          "type": "array"
        }
      },
      "title": "MemoryPolicy",
      "type": "object"
    },
    "RealtimeRuntime": {
      "properties": {
        "target_platforms": {
          "items": {
            "type": "string"
          },
          "title": "Target Platforms",
          "type": "array"
        },
        "render": {
          "$ref": "#/$defs/RenderConfig"
        },
        "tracking": {
          "$ref": "#/$defs/TrackingConfig"
        },
        "latency_targets": {
          "$ref": "#/$defs/LatencyTargets"
        },
        "streaming": {
          "$ref": "#/$defs/StreamingConfig"
        }
      },
      "title": "RealtimeRuntime",
      "type": "object"
    },
    "RenderConfig": {
      "properties": {
        "target_fps": {
          "default": 60,
          "title": "Target Fps",
          "type": "integer"
        },
        "fallback_fps": {
          "default": 30,
          "title": "Fallback Fps",
          "type": "integer"
        },
        "camera": {
          "default": "medium close-up",
          "title": "Camera",
          "type": "string"
        },
        "background": {
          "default": "scene-dependent",
          "title": "Background",
          "type": "string"
        },
        "lighting": {
          "default": "soft warm key light with subtle rim light",
          "title": "Lighting",
          "type": "string"
        }
      },
      "title": "RenderConfig",
      "type": "object"
    },
    "ResponseContract": {
      "properties": {
        "format": {
          "const": "json",
          "default": "json",
          "title": "Format",
          "type": "string"
        },
        "required_fields": {
          "$ref": "#/$defs/ResponseContractRequiredFields"
        },
        "example": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponseContractExample"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ResponseContract",
      "type": "object"
    },
    "ResponseContractExample": {
      "properties": {
        "speech": {
          "title": "Speech",
          "type": "string"
        },
        "emotion": {
          "title": "Emotion",
          "type": "string"
        },
        "intensity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "gesture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gesture"
        },
        "safety_action": {
          "default": "allow",
          "enum": [
            "allow",
            "redirect",
            "refuse"
          ],
          "title": "Safety Action",
          "type": "string"
        }
      },
      "required": [
        "speech",
        "emotion",
        "intensity"
      ],
      "title": "ResponseContractExample",
      "type": "object"
    },
    "ResponseContractRequiredFields": {
      "properties": {
        "speech": {
          "default": "string",
          "title": "Speech",
          "type": "string"
        },
        "emotion": {
          "default": "neutral|curious|happy|excited|comforting|confused|concerned",
          "title": "Emotion",
          "type": "string"
        },
        "intensity": {
          "default": "number between 0 and 1",
          "title": "Intensity",
          "type": "string"
        },
        "gesture": {
          "default": "string or null",
          "title": "Gesture",
          "type": "string"
        },
        "safety_action": {
          "default": "allow|redirect|refuse",
          "title": "Safety Action",
          "type": "string"
        }
      },
      "title": "ResponseContractRequiredFields",
      "type": "object"
    },
    "RuntimeInputs": {
      "properties": {
        "required": {
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "optional": {
          "items": {
            "type": "string"
          },
          "title": "Optional",
          "type": "array"
        }
      },
      "title": "RuntimeInputs",
      "type": "object"
    },
    "SafetyPolicy": {
      "properties": {
        "rating": {
          "const": "family_friendly",
          "default": "family_friendly",
          "title": "Rating",
          "type": "string"
        },
        "never_generate": {
          "items": {
            "type": "string"
          },
          "title": "Never Generate",
          "type": "array"
        },
        "refusal_style": {
          "default": "brief, kind, clear, and provide a safe alternative",
          "title": "Refusal Style",
          "type": "string"
        },
        "tool_actions": {
          "$ref": "#/$defs/ToolActions"
        }
      },
      "title": "SafetyPolicy",
      "type": "object"
    },
    "StreamingConfig": {
      "properties": {
        "stream_text": {
          "default": true,
          "title": "Stream Text",
          "type": "boolean"
        },
        "stream_audio": {
          "default": true,
          "title": "Stream Audio",
          "type": "boolean"
        },
        "support_barge_in": {
          "default": true,
          "title": "Support Barge In",
          "type": "boolean"
        },
        "pause_when_user_speaks": {
          "default": true,
          "title": "Pause When User Speaks",
          "type": "boolean"
        },
        "resume_after_interruption": {
          "default": true,
          "title": "Resume After Interruption",
          "type": "boolean"
        }
      },
      "title": "StreamingConfig",
      "type": "object"
    },
    "TTSRequirements": {
      "properties": {
        "phoneme_visemes": {
          "default": true,
          "title": "Phoneme Visemes",
          "type": "boolean"
        },
        "emotion_control": {
          "default": true,
          "title": "Emotion Control",
          "type": "boolean"
        },
        "streaming_audio": {
          "default": true,
          "title": "Streaming Audio",
          "type": "boolean"
        },
        "natural_pauses": {
          "default": true,
          "title": "Natural Pauses",
          "type": "boolean"
        }
      },
      "title": "TTSRequirements",
      "type": "object"
    },
    "ToolActions": {
      "properties": {
        "confirmation_required": {
          "default": true,
          "title": "Confirmation Required",
          "type": "boolean"
        },
        "never_execute_without_confirmation": {
          "items": {
            "type": "string"
          },
          "title": "Never Execute Without Confirmation",
          "type": "array"
        }
      },
      "title": "ToolActions",
      "type": "object"
    },
    "TrackingConfig": {
      "properties": {
        "face_tracking": {
          "default": true,
          "title": "Face Tracking",
          "type": "boolean"
        },
        "eye_tracking": {
          "default": true,
          "title": "Eye Tracking",
          "type": "boolean"
        },
        "head_tracking": {
          "default": true,
          "title": "Head Tracking",
          "type": "boolean"
        },
        "voice_lip_sync": {
          "default": true,
          "title": "Voice Lip Sync",
          "type": "boolean"
        },
        "hand_tracking": {
          "default": true,
          "title": "Hand Tracking",
          "type": "boolean"
        },
        "tail_and_ear_automation": {
          "default": true,
          "title": "Tail And Ear Automation",
          "type": "boolean"
        }
      },
      "title": "TrackingConfig",
      "type": "object"
    },
    "TransitionRule": {
      "properties": {
        "event": {
          "title": "Event",
          "type": "string"
        },
        "from": {
          "items": {
            "type": "string"
          },
          "title": "From",
          "type": "array"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "event",
        "from",
        "to"
      ],
      "title": "TransitionRule",
      "type": "object"
    }
  },
  "properties": {
    "schema_id": {
      "const": "live-character-prompt",
      "default": "live-character-prompt",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "prompt_id": {
      "title": "Prompt Id",
      "type": "string"
    },
    "version": {
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    },
    "mode": {
      "const": "real_time_interactive_avatar",
      "default": "real_time_interactive_avatar",
      "title": "Mode",
      "type": "string"
    },
    "character": {
      "$ref": "#/$defs/LiveCharacterSpec"
    },
    "system_prompt": {
      "title": "System Prompt",
      "type": "string"
    },
    "visual_prompt": {
      "title": "Visual Prompt",
      "type": "string"
    },
    "negative_prompt": {
      "items": {
        "type": "string"
      },
      "title": "Negative Prompt",
      "type": "array"
    },
    "realtime_runtime": {
      "$ref": "#/$defs/RealtimeRuntime"
    },
    "live_state_machine": {
      "$ref": "#/$defs/LiveStateMachine"
    },
    "voice": {
      "$ref": "#/$defs/LiveVoiceConfig"
    },
    "conversation_rules": {
      "items": {
        "type": "string"
      },
      "title": "Conversation Rules",
      "type": "array"
    },
    "runtime_inputs": {
      "$ref": "#/$defs/RuntimeInputs"
    },
    "response_contract": {
      "$ref": "#/$defs/ResponseContract"
    },
    "memory_policy": {
      "$ref": "#/$defs/MemoryPolicy"
    },
    "safety_policy": {
      "$ref": "#/$defs/SafetyPolicy"
    },
    "quality_gates": {
      "items": {
        "type": "string"
      },
      "title": "Quality Gates",
      "type": "array"
    }
  },
  "required": [
    "prompt_id",
    "character",
    "system_prompt",
    "visual_prompt"
  ],
  "title": "LiveCharacterPrompt",
  "type": "object"
}