{
  "$defs": {
    "CameraSpec": {
      "properties": {
        "shot": {
          "default": "medium",
          "title": "Shot",
          "type": "string"
        },
        "movement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Movement"
        }
      },
      "title": "CameraSpec",
      "type": "object"
    },
    "MotionSpec": {
      "properties": {
        "body": {
          "default": "gentle natural movement",
          "title": "Body",
          "type": "string"
        },
        "face": {
          "default": "soft blinking and smiling",
          "title": "Face",
          "type": "string"
        },
        "secondary": {
          "default": "subtle secondary movement",
          "title": "Secondary",
          "type": "string"
        }
      },
      "title": "MotionSpec",
      "type": "object"
    },
    "SceneManifestEntry": {
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "script_scene_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script Scene Id"
        },
        "shot_type": {
          "default": "hero",
          "title": "Shot Type",
          "type": "string"
        },
        "timeline_start": {
          "default": 0.0,
          "title": "Timeline Start",
          "type": "number"
        },
        "duration": {
          "default": 8.0,
          "title": "Duration",
          "type": "number"
        },
        "characters": {
          "items": {
            "type": "string"
          },
          "title": "Characters",
          "type": "array"
        },
        "reference_images": {
          "items": {
            "type": "string"
          },
          "title": "Reference Images",
          "type": "array"
        },
        "environment": {
          "default": "simple soft background",
          "title": "Environment",
          "type": "string"
        },
        "action": {
          "default": "",
          "title": "Action",
          "type": "string"
        },
        "camera": {
          "$ref": "#/$defs/CameraSpec"
        },
        "motion": {
          "$ref": "#/$defs/MotionSpec"
        },
        "aspect_ratio": {
          "default": "16:9",
          "title": "Aspect Ratio",
          "type": "string"
        },
        "learning_point": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learning Point"
        },
        "negative_prompt": {
          "default": "change clothing, change face, add characters, add accessories, change body proportions, scary imagery, watermarks, text overlays",
          "title": "Negative Prompt",
          "type": "string"
        }
      },
      "required": [
        "scene_id"
      ],
      "title": "SceneManifestEntry",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SceneManifestEntry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "episode_id"
  ],
  "title": "SceneManifest",
  "type": "object"
}